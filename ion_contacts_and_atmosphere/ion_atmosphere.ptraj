parm /data/mcohen3/SH3/salt_binding_800mM/cluster_0/prmtop/ArkA12_0_gas_ions.prmtop

trajin /data/mcohen3/SH3/salt_binding_800mM/cluster_0/mdcrd/stripped_cluster/cluster_0_allsim.mdcrd
trajin /data/mcohen3/SH3/salt_binding_800mM/cluster_1/mdcrd/stripped_cluster/cluster_1_allsim.mdcrd
trajin /data/mcohen3/SH3/salt_binding_800mM/cluster_2/mdcrd/stripped_cluster/cluster_2_allsim.mdcrd
trajin /data/mcohen3/SH3/salt_binding_800mM/cluster_3/mdcrd/stripped_cluster/cluster_3_allsim.mdcrd
trajin /data/mcohen3/SH3/salt_binding_800mM/cluster_4/mdcrd/stripped_cluster/cluster_4_allsim.mdcrd

radial out radial_dist_Na.dat 0.1 15.0 :1-72 :Na+ rawrdf raw_rdf_Na.dat
radial out radial_dist_Cl.dat 0.1 15.0 :1-72 :Cl- rawrdf raw_rdf_Cl.dat

mask "(:1-72<:3.0)&:Na+" maskout 3A_Na.dat
mask "(:1-72<:3.0)&:Cl-" maskout 3A_Cl.dat

mask "(:1-72<:9.0)&:Na+" maskout 9A_Na.dat
mask "(:1-72<:9.0)&:Cl-" maskout 9A_Cl.dat

run
quit 
